{
  "name": "android-audio-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-content.mjs && vite",
    "build": "node scripts/build-content.mjs && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "content": "node scripts/build-content.mjs",
    "sources": "node scripts/fetch-sources.mjs",
    "sync": "node scripts/sync-curriculum.mjs",
    "sync:check": "node scripts/sync-curriculum.mjs --check && node scripts/build-content.mjs --check"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "beasties": "0.5.4",
    "linkedom": "0.18.13",
    "vite": "^6.0.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "marked": "18.0.14",
    "mermaid": "11.17.2"
  }
}
