{
  "$id": "source.schema.json",
  "title": "Pinned AOSP source reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo", "path"],
  "properties": {
    "repo": { "enum": ["frameworks/av", "frameworks/base", "hardware/interfaces", "packages/services/Car", "system/media", "external/tinyalsa", "kernel/common"] },
    "path": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
    "symbol": { "type": "string", "minLength": 3, "description": "Literal substring; resolved to a line at AOSP_TAG by fetch-sources.mjs" },
    "occurrence": { "type": "integer", "minimum": 1 },
    "before": { "type": "integer", "minimum": 0, "maximum": 24 },
    "after": { "type": "integer", "minimum": 0, "maximum": 29 },
    "label": { "type": "string" }
  }
}
